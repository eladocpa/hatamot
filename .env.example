# ============================================================
#  קובץ הגדרות סודי - דוגמה
# ============================================================
# העתק את הקובץ הזה לקובץ חדש בשם .env (בלי ה-example)
# ומלא בו את המפתח שלך. הקובץ .env לעולם לא נשמר ב-git.
#
# בווינדוס אפשר להעתיק בפקודה:   copy .env.example .env
# במאק/לינוקס:                    cp .env.example .env
# ============================================================

# מפתח ה-API של Claude (מתחיל ב-sk-ant-...)
# משיגים אותו ב: https://console.anthropic.com  ->  API Keys
ANTHROPIC_API_KEY=sk-ant-הדבק-כאן-את-המפתח-שלך
